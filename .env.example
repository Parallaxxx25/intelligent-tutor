# =============================================================================
# Intelligent Agentic Tutoring System — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values

# --- LLM ---
GOOGLE_API_KEY=[GEMINI_API_KEY]
OPENROUTER_API_KEY=[OPENROUTER_API_KEY]

# --- Observability ---
LANGSMITH_API_KEY=lsv2_pt_your-langsmith-key-here
LANGCHAIN_TRACING=true
LANGCHAIN_PROJECT=intelligent-tutor
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- Databases ---
POSTGRES_URL=postgresql+asyncpg://tutor:tutor_pass@localhost:5432/tutor_db
POSTGRES_URL_SYNC=postgresql://tutor:tutor_pass@localhost:5432/tutor_db
# REDIS_PASSWORD sets docker-compose's --requirepass; REDIS_URL must embed the
# same password for the app: redis://:PASSWORD@host:6379/0. Leave both empty
# for local dev. Required for any self-hosted/internet-reachable deploy.
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0

# --- Code Execution ---
CODE_EXEC_TIMEOUT=5
CODE_EXEC_MAX_MEMORY_MB=256

# --- RAG (optional — sensible defaults in backend/config.py) ---
# Persistent by default (backend/config.py: ./.chroma). Override or set to
# empty to force in-memory (ephemeral) storage, e.g. for tests.
# CHROMA_PERSIST_DIR=./.chroma
# SLIDE_MATERIAL_DIR=slide-material
# SLIDE_RAG_ENABLED=true

# --- Security ---
# Empty = auth disabled (local dev only). Set in staging/prod to require the
# X-API-Key header on /api/submit, /api/debug/*, and /api/users/{id}/data.
API_KEY=
# Separate key from API_KEY, checked on /api/v1/grade and /api/v1/hint — the
# server-to-server surface an integrating platform's backend calls (see
# docs/adr/0006-partner-primary-dual-grade.md). Empty = auth disabled, same
# local-dev convention as API_KEY. Rotate independently from API_KEY.
SERVICE_KEY=
INTERACTION_RETENTION_DAYS=180

# --- Application ---
ENV=development
DEBUG=true
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
# "deterministic" (default) | "llm" | "langgraph" — only affects /api/submit
# (the Streamlit playground's endpoint), not /api/v1/grade + /api/v1/hint,
# which always use the LLM diagnose_and_hint path directly.
DEFAULT_PIPELINE_MODE=llm
